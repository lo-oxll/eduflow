# Copy to .env for local development. NEVER commit .env.

# --- Core ---
NODE_ENV=development            # production on the server
PORT=8000
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRES_HOURS=8
TRUST_PROXY=0                   # 1 behind Render/nginx
CORS_ORIGINS=                   # e.g. https://eduflow.onrender.com (empty = same-origin)
UPLOADS_DIR=                    # persistent path if your host has a disk

# --- Portal passwords (default: required in production) ---
REQUIRE_PORTAL_PASSWORDS=

# --- Database ---
# Empty = local SQLite (school.db). Production = Supabase "Session pooler" string:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# --- Optional ---
REDIS_URL=
